-- ==================== LOADING ANIMATION (0% to 100%) ====================
task.spawn(function()
	local startTime = tick()
	local duration = 2
	
	local statuses = {
		{0.2, "Loading core modules..."},
		{0.5, "Bypassing anti-cheat vectors..."},
		{0.8, "Assembling UI framework..."},
		{0.95, "Ready!"}
	}
	
	while tick() - startTime < duration do
		local elapsed = tick() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)
		
		BarFill.Size = UDim2.new(alpha, 0, 1, 0)
		PercentLabel.Text = math.floor(alpha * 100) .. "%"
		
		for _, stat in ipairs(statuses) do
			if alpha >= stat[1] then
				StatusLabel.Text = stat[2]
			end
		end
		
		RunService.RenderStepped:Wait()
	end
	
	BarFill.Size = UDim2.new(1, 0, 1, 0)
	PercentLabel.Text = "100%"
	StatusLabel.Text = "Loaded successfully!"
	task.wait(0.4)
	
	local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(LoadingFrame, fadeInfo, {BackgroundTransparency = 1}):Play()
	for _, child in pairs(LoadContainer:GetDescendants()) do
		if child:IsA("TextLabel") then
			TweenService:Create(child, fadeInfo, {TextTransparency = 1}):Play()
		elseif child:IsA("Frame") then
			TweenService:Create(child, fadeInfo, {BackgroundTransparency = 1}):Play()
		elseif child:IsA("ImageLabel") then
			TweenService:Create(child, fadeInfo, {ImageTransparency = 1}):Play()
		elseif child:IsA("UIStroke") then
			-- UIStroke ignores direct transparency, let parent fade handle it
		end
	end
	
	task.wait(0.5)
	LoadingFrame:Destroy()
	FloatBtn.Visible = true
	notify("Sploitware HUB", "Loaded successfully! Click the logo to open.", 3)
end)

-- ==================== SMOOTH TRAIL OPENING EFFECT ====================
FloatBtn.MouseButton1Click:Connect(function()
	if MainWin.Visible then
		MainWin.Visible = false
		FloatBtn.Visible = true
		return
	end
	
	local trail = Instance.new("Frame")
	trail.Size = UDim2.new(0, 58, 0, 58)
	trail.Position = FloatBtn.Position
	trail.AnchorPoint = Vector2.new(0.5, 0.5)
	trail.BackgroundColor3 = Color3.fromRGB(220, 30, 40)
	trail.BackgroundTransparency = 0.3
	trail.BorderSizePixel = 0
	trail.ZIndex = 10
	trail.Parent = ScreenGui
	
	Instance.new("UICorner", trail).CornerRadius = UDim.new(1, 0)
	
	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(trail, tweenInfo, {
		Size = UDim2.new(0, 650, 0, 480),
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0.5, 0)
	}):Play()
	
	task.delay(0.4, function()
		trail:Destroy()
		MainWin.Visible = true
		MainWin.Size = UDim2.new(0, 0, 0, 0)
		TweenService:Create(MainWin, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 550, 0, 390)}):Play()
	end)
end)
